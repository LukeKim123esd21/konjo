{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["NORMAL", "VIP"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "PortfolioItem": {
      "title": "PortfolioItem",
      "description": "Instagram-style portfolio image or video",
      "type": "object",
      "properties": {
        "image": { "type": "string" },
        "videoUrl": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["image", "title", "createdAt"]
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "Dynamic text and media content for the landing page",
      "type": "object",
      "properties": {
        "heroTitle": { "type": "string" },
        "heroDesc": { "type": "string" },
        "heroMediaUrl": { "type": "string" },
        "heroMediaType": { "type": "string", "enum": ["image", "video"] },
        "footerText": { "type": "string" }
      }
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Public calendar events",
      "type": "object",
      "properties": {
        "date": { "type": "string", "description": "YYYY-MM-DD" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["BOOKED", "AVAILABLE", "EVENT"] },
        "createdBy": { "type": "string" }
      },
      "required": ["date", "title", "type"]
    },
    "Product": {
      "title": "Product",
      "description": "Limited drop product items",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "instaLink": { "type": "string" },
        "prices": { "type": "object" },
        "dropDate": { "type": "string", "format": "date-time" },
        "vipDropDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "image", "instaLink", "prices", "dropDate", "vipDropDate", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/portfolio/{itemId}": {
      "schema": "PortfolioItem",
      "description": "Portfolio archive"
    },
    "/settings/content": {
      "schema": "SiteContent",
      "description": "Global CMS settings"
    },
    "/schedules/{scheduleId}": {
      "schema": "Schedule",
      "description": "Public booking schedules"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Limited drop items"
    }
  }
}
