rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'butangas199@gmail.com';
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt', 'updatedAt']) 
          && data.keys().size() == 5
          && data.email is string && data.email.size() <= 200
          && data.displayName is string && data.displayName.size() <= 100
          && data.role in ['NORMAL', 'VIP']
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    function isValidPortfolio(data) {
      return data.keys().hasAll(['image', 'title', 'createdAt'])
          && data.image is string && data.image.size() <= 1000
          && data.title is string && data.title.size() <= 200
          && data.createdAt is timestamp
          && (data.keys().hasOnly(['image', 'title', 'createdAt', 'videoUrl']));
    }

    function isValidSchedule(data) {
      return data.keys().hasAll(['date', 'title', 'type', 'createdBy'])
          && data.keys().size() == 4
          && data.date is string && data.date.size() == 10
          && data.title is string && data.title.size() <= 200
          && data.type in ['BOOKED', 'AVAILABLE', 'EVENT']
          && data.createdBy is string;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['heroTitle', 'heroDesc', 'footerText'])
          && data.heroTitle is string && data.heroTitle.size() <= 200
          && data.heroDesc is string && data.heroDesc.size() <= 2000
          && data.footerText is string && data.footerText.size() <= 200
          && (data.keys().hasOnly(['heroTitle', 'heroDesc', 'footerText', 'heroMediaUrl', 'heroMediaType']));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'prices', 'dropDate', 'vipDropDate', 'description', 'image', 'instaLink', 'createdAt'])
          && data.keys().size() == 8
          && data.name is string && data.name.size() <= 200
          && data.prices is map
          && data.dropDate is string && data.dropDate.size() <= 30
          && data.vipDropDate is string && data.vipDropDate.size() <= 30
          && data.description is string && data.description.size() <= 2000
          && data.image is string && data.image.size() <= 1000
          && data.instaLink is string && data.instaLink.size() <= 1000
          && data.createdAt is timestamp;
    }

    // --- Collections ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) 
                    && isValidUser(incoming())
                    && incoming().role == 'NORMAL'
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      
      allow update: if (isOwner(userId) || isAdmin())
                    && isValidUser(incoming())
                    && (
                      isAdmin() ||
                      (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
                      && incoming().updatedAt == request.time)
                    );
    }

    match /portfolio/{itemId} {
      allow read: if true;
      allow create: if isAdmin() && isValidPortfolio(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidPortfolio(incoming());
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      allow create: if isAdmin() && isValidSchedule(incoming());
      allow update: if isAdmin() && isValidSchedule(incoming());
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming()) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
    }
  }
}
