rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Validation
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt', 'updatedAt']) 
          && data.keys().size() == 5
          && data.email is string && data.email.size() <= 200
          && data.displayName is string && data.displayName.size() <= 100
          && data.role in ['NORMAL', 'VIP']
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'butangas199@gmail.com';
    }

    // --- Collections ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) 
                    && isValidUser(incoming())
                    && incoming().role == 'NORMAL'
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time;
      
      allow update: if (isOwner(userId) || isAdmin())
                    && isValidUser(incoming())
                    && (
                      isAdmin() ||
                      (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
                      && incoming().updatedAt == request.time)
                    );
    }

    match /portfolio/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
